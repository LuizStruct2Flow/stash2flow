# is concerned and both runners stay green over it. Committed, replacing the
# `if ! … blueprint files …; then … exit 1; fi` refusal in scripts/new-project.sh
# with a plain invocation turns #7 red in both runners, on the same assertion
# and with the same evidence: `set -e` then kills
# bootstrap with the CLI's own status and prints nothing at all, so the refusal
# names no cause and the operator has nothing to act on. #7b stays green, which
# is the point of having both — the empty-list refusal is a different branch.

# ============================================================================
# DoD handoff checklist — rendered as STAGES, tagged [DoD-Gate] in the feed.
#
# The founder's reason, which is stronger than "it checks things": these print,
# so a run that SKIPPED them is visible. "If I see things moving without this,
# I know that at least one step was forgotten." The stage COUNT is the checksum
# — fewer stages than usual means a step did not run — and pipe_skip requires a
# reason, so a legitimate skip announces itself rather than vanishing.
#
# Tagged distinctly because "which steps ran" is only answerable if they are
# distinguishable from the suite stages around them.
#
# Unlocked by TASK-002: every commit subject now starts with its backlog item,
# so the gate can derive which items this push serves. `push_log_opts` (defined
# in .githooks/pre-push for the secret scan) gives the outgoing range.
# ============================================================================
if [ -f "$BP_CODE_ROOT/scripts/lib/dod-gate.mts" ]; then
  _dod_ranges="$(push_log_opts)"

  AGENT_FEED_TAG="DoD-Gate"

  _st_dod_rows(){ DOD_GATE_NOTE_FILE="${_PIPE_DIR:+$_PIPE_DIR/note.$_PIPE_N}" node "$BP_CODE_ROOT/scripts/lib/dod-gate.mts" rows "$_dod_ranges"; }
  pipe_stage "§1b·1 every item has a backlog row" _st_dod_rows

  _st_dod_bugtests(){ DOD_GATE_NOTE_FILE="${_PIPE_DIR:+$_PIPE_DIR/note.$_PIPE_N}" node "$BP_CODE_ROOT/scripts/lib/dod-gate.mts" bugtests "$_dod_ranges"; }
  pipe_stage "§2 every BUG has a regression test" _st_dod_bugtests

  _st_dod_signal(){ DOD_GATE_NOTE_FILE="${_PIPE_DIR:+$_PIPE_DIR/note.$_PIPE_N}" node "$BP_CODE_ROOT/scripts/lib/dod-gate.mts" signal; }
  pipe_stage "§7G the live baton is well-formed" _st_dod_signal

  _st_dod_judgement(){ DOD_GATE_NOTE_FILE="${_PIPE_DIR:+$_PIPE_DIR/note.$_PIPE_N}" node "$BP_CODE_ROOT/scripts/lib/dod-gate.mts" judgement; }
  pipe_stage "§D·F·H judgement — printed, not verified" _st_dod_judgement

  AGENT_FEED_TAG="GATE"
else
  # Fails LOUD rather than silently dropping four stages: a shorter run is
  # exactly the signal the founder watches for, so it must carry its reason.
  pipe_skip "DoD checklist" "scripts/lib/dod-gate.mts absent — run: blueprint pull scripts/lib/dod-gate.mts"
fi

# --- TASK-018: the TypeScript suites ----------------------------------------
#
# ONE vitest process, rendered as one stage PER SUITE.
#
# Forty-two separate invocations would mean forty-two Node startups and would
# discard the parallelism that is the whole point. But collapsing them into a
# single "vitest" stage breaks two things that matter: tests/bootstrap-gate #3
# requires a derived project's gate to pass >= 25 stages as an explicit
# non-vacuity guard, and `slowest: vitest 200s` names nothing anyone can act
# on. scripts/run-ts-suites.sh bridges the two through pipeline.sh's batch API
# (PLAN-TASK-018 §7.3).
#
# The expected suite list comes from the *.spec.ts files on disk, never from
# vitest's own output — otherwise every guard reduces to trusting the runner, and
# a suite dropped from the include glob vanishes with the gate still green.
# Verified by breaking it: narrowing the glob produces both a named per-suite
# failure and a runner-contradicts-its-report failure. (It came from
# tests/SUITES.md until TASK-020 deleted that table; `find` is the same property
# from a source that is the tests rather than a description of them.)
#
# Placed here, at the END of the managed region, deliberately. It is the only
# stage that needs a toolchain the rest of the gate does not, so a machine
# missing it fails one clearly-named stage rather than poisoning earlier ones.
#
# TASK-053: a text-only push (.githooks/pre-push decides it) skips the three
# code stages with a reason and runs only the suites that judge documents.
: "${_PP_TEXT_ONLY:=0}"
if [ "$_PP_TEXT_ONLY" = "1" ] && [ -f "$BP_CODE_ROOT/scripts/run-ts-suites.sh" ]; then
  # shellcheck source=scripts/run-ts-suites.sh
  . "$BP_CODE_ROOT/scripts/run-ts-suites.sh"
  pipe_skip "shellcheck · TASK-033" "text-only push: no shell script changed"
  pipe_skip "typecheck · TASK-031" "text-only push: no TypeScript changed"
  pipe_skip "vitest · TASK-018" "text-only push: only the document suites run"
  ts_docs_stage "$BP_CODE_ROOT"
elif [ -f "$BP_CODE_ROOT/scripts/run-ts-suites.sh" ]; then
  # shellcheck source=scripts/run-ts-suites.sh
  . "$BP_CODE_ROOT/scripts/run-ts-suites.sh"
  # TASK-033: lint the tracked shell scripts. It needs no Node and takes about a
  # second, and it blocks when ShellCheck is missing. The same function runs in
  # CI (.github/workflows/security.yml), and tests/ts-bridge #6 and #7 prove both.
  sh_lint_stage "$BP_CODE_ROOT"
  # TASK-031: typecheck tests/ first. vitest strips types without checking
  # them, so without this a type error pushes green. The same function runs in
  # CI (.github/workflows/security.yml), and tests/ts-bridge #4 and #5 prove both.
  ts_typecheck_stage "$BP_CODE_ROOT"
  # BUG-066: the CODE root, not `pwd`. This argument is what the bridge uses to
  # find tests/vitest.config.ts and the *.spec.ts population.
  ts_suites_stage "$BP_CODE_ROOT"
else
  pipe_skip "shellcheck · TASK-033" "scripts/run-ts-suites.sh absent — run: blueprint pull scripts/run-ts-suites.sh"
  pipe_skip "typecheck · TASK-031" "scripts/run-ts-suites.sh absent — run: blueprint pull scripts/run-ts-suites.sh"
  pipe_skip "vitest · TASK-018" "scripts/run-ts-suites.sh absent — run: blueprint pull scripts/run-ts-suites.sh"
fi
